<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp" android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_observer" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityHeading="true"
            android:text="@string/page_title" android:textColor="#172C34"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/page_subtitle" android:textColor="#5D6E79" android:textSize="15sp" />
        <TextView
            android:id="@+id/environment"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/badge"
            android:paddingHorizontal="12dp" android:paddingVertical="7dp"
            android:text="@string/environment_name" android:textColor="#125C55" android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginBottom="24dp"
            android:text="@string/environment_description" android:textColor="#5D6E79" android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card" android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/preparing" android:textColor="#172C34"
                android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="horizontal">
                <TextView style="@style/StatusLabel" android:text="@string/permission_label" />
                <TextView android:id="@+id/permission_status" style="@style/StatusValue" android:text="@string/permission_missing" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:orientation="horizontal">
                <TextView style="@style/StatusLabel" android:text="@string/listener_label" />
                <TextView android:id="@+id/listener_status" style="@style/StatusValue" android:text="@string/listener_idle" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="horizontal">
                <TextView style="@style/StatusLabel" android:text="@string/binding_label" />
                <TextView android:id="@+id/binding_status" style="@style/StatusValue" android:text="@string/binding_idle" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="horizontal">
                <TextView style="@style/StatusLabel" android:text="@string/events_label" />
                <TextView android:id="@+id/events_status" style="@style/StatusValue" android:text="@string/events_empty" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/parser_title" android:textColor="#172C34" />
        <CheckBox android:id="@+id/wx_parser" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wx_parser" />
        <CheckBox android:id="@+id/ali_parser" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ali_parser" />
        <TextView android:id="@+id/parser_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#172C34" />
        <TextView android:id="@+id/parser_reasons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#5D6E79" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/parser_note" android:textColor="#5D6E79" />
        <Button android:id="@+id/permission_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/open_permission" />
        <Button android:id="@+id/reconnect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/reconnect" />
        <TextView android:id="@+id/persistence_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#172C34" />
        <TextView android:id="@+id/observation_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#172C34" />
        <TextView android:id="@+id/capture_warning" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/capture_memory_only" android:textColor="#5D6E79" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/card"
            android:orientation="vertical" android:padding="24dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityHeading="true" android:gravity="center"
                android:text="@string/empty_title" android:textColor="#172C34"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="5dp"
                android:text="@string/empty_description" android:textColor="#5D6E79" android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center"
            android:text="@string/privacy_note" android:textColor="#5D6E79" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
